{
  "name": "mediflex-pos",
  "version": "1.0.2",
  "description": "Mediflex Pharmacy POS System",
  "author": "Mediflex",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "vite preview --port 8080 --host",
    "electron:start": "electron .",
    "electron:build": "tsc -p electron",
    "electron:dev": "concurrently \"vite --port 3000\" \"wait-on http://localhost:3000 && npm run electron:start\"",
    "electron:dist": "npm run build && npm run electron:build && electron-builder --win",
    "electron:dist:msi": "npm run build && npm run electron:build && electron-builder --win msi",
    "electron:dist:msi:x64": "npm run build && npm run electron:build && electron-builder --win msi --x64",
    "electron:dist:msi:ia32": "npm run build && npm run electron:build && electron-builder --win msi --ia32",
    "electron:dist:msi:all": "npm run build && npm run electron:build && electron-builder --win msi --x64 --ia32",
    "electron:dist:all": "npm run build && npm run electron:build && electron-builder --win --x64 --ia32",
    "electron:dist:x64": "npm run build && npm run electron:build && electron-builder --win --x64",
    "electron:dist:ia32": "npm run build && npm run electron:build && electron-builder --win --ia32"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "electron-updater": "^6.8.11",
    "express": "^5.2.1",
    "framer-motion": "^11.5.4",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "react-to-print": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "concurrently": "^9.2.1",
    "electron": "22.3.27",
    "electron-builder": "^26.7.0",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.mediflex.pos",
    "productName": "Mediflex POS System",
    "electronVersion": "22.3.27",
    "publish": [
      {
        "provider": "github",
        "owner": "savindu19990928",
        "repo": "PPOS-fe"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "msi": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mediflex POS System",
      "upgradeCode": "E5A3D73A-93B4-4B7C-A5D1-C968DA520842",
      "warningsAsErrors": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mediflex POS System",
      "perMachine": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true
  }
}